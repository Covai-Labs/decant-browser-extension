---
// Shared document shell: head, meta, fonts, CSS, theme bootstrap, analytics.
import '../styles/global.css';
import WaveBackground from '../components/WaveBackground.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Canonical path handled by the current request. */
  canonicalPath?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
  includeAnalytics?: boolean;
}

const {
  title,
  description,
  canonicalPath = '/',
  ogType = 'website',
  ogImage = '/og-image.png',
  noindex = false,
  jsonLd,
  includeAnalytics = true,
} = Astro.props;

const canonical = new URL(canonicalPath, SITE.url).toString();
const image = new URL(ogImage, SITE.url).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <link rel="canonical" href={canonical} />
    )}

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Theme bootstrap (pre-paint — prevents flash) -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('decant-theme');
          if (t === 'dark' || t === 'light') {
            document.documentElement.setAttribute('data-theme', t);
          }
        } catch (e) {
          /* ignore */
        }
      })();
    </script>
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/icon32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/icon16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/android-chrome-192x192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icons/android-chrome-512x512.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Styles -->
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>}

    {includeAnalytics && <script defer src="https://covai.org/analytics.js"></script>}
  </head>
  <body>
    <WaveBackground />
    <slot />
  </body>
</html>
