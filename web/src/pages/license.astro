---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="License — Decant"
  description="Decant open-source license information."
  canonicalPath="/license.html"
>
  <Header />
  <main class="reading-page legal shell">
    <p class="eyebrow">License</p>
    <h1>Open by default.</h1>
    <p class="lede">Decant is released under the GNU Affero General Public License, version 3.</p>
    <p>
      The source code is available on{' '}
      <a href="https://github.com/Covai-Labs/decant-browser-extension" target="_blank" rel="noopener noreferrer">
        GitHub
      </a>
      . You may use, study, modify, and share the project under the terms of the license.
    </p>
    <p>See the complete license text in the repository or read the copy distributed with Decant.</p>
  </main>
  <Footer />
</BaseLayout>
